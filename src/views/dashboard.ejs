<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="dashboard-form">
            <h2>Dashboard</h2>

            <p>Name: <%= name %>
            </p>
            <p>Username: <%= email %>
            </p>

            <% if (user && user.role_name==='admin' ) { %>
                <p>
                    <a href="/users">View Registered Users</a>
                </p>
                <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>