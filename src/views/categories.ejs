    <main>
        <h1>Categories</h1>
        <div class="serviceCategories">
            <% categories.forEach(category => { %>
                <div class="category">
                    <h2><%= category.name %></h2>
                    <p><%= category.description %></p>
                </div>
            <% }); %>
        </div>
    </main>

