<%- include('partials/header') %>

    <main>
        <h1>Categories</h1>
        <div class="serviceCategories">
            <% categories.forEach(category => { %>
                <div class="category">
                    <h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>
                </div>
            <% }); %>
        </div>
    </main>

<%- include('partials/footer') %>