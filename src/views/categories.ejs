<%- include('partials/header') %>

    <main>
        <h1>Categories</h1>
        <% if (user && user.role_name==='admin' ) { %>
        <a href="/new-category">Create New Category</a>
        <% } %>
        <div class="serviceCategories">
            <% categories.forEach(category => { %>
                <div class="category">
                    <h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>
                </div>
            <% }); %>
        </div>
    </main>

<%- include('partials/footer') %>