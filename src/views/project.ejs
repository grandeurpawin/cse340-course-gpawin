<%- include ('partials/header') %>

    <main>
        <h1><%= project.title %></h1>
        <p><%= project.description %></p>

        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
            day: 'numeric' }) %></p>

        <p><strong>Location:</strong> <%= project.location %></p>

        <p><strong>Organization:</strong> <%= project.organization_name %></p>

        <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>

    </main>

    <%- include('partials/footer') %>