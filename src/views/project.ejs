<%- include('partials/header') %>

    <main>
        <h1>
            <%= project.title %>
        </h1>
        <p>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' })
                %>
        </p>

        <p><strong>Location:</strong>
            <%= project.location %>
        </p>
        <p><strong>Organization:</strong>
            <%= project.organization_name %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>
            <p>
                <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
            </p>
            <p>
                <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
            </p>
            <% } %>

                <section class="volunteer-signup">
                    <h2>Volunteer for This Project</h2>

                    <% if (!user) { %>
                        <p>
                            Please <a href="/login">log in</a> to sign up as a volunteer.
                        </p>
                        <% } else if (isVolunteer) { %>
                            <p>You have signed up to volunteer for this project.</p>

                            <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                                <button type="submit">Remove Volunteer Signup</button>
                            </form>
                            <% } else { %>
                                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                                    <button type="submit">Sign Up to Volunteer</button>
                                </form>
                                <% } %>
                </section>
    </main>

    <%- include('partials/footer') %>